SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Supabase project ref (the ID in your Supabase URL)
SUPABASE_PROJECT_REF=your-project-ref

# Personal access token — https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your-access-token

# JWT — generate a strong random secret (e.g. openssl rand -hex 64)
JWT_SECRET=your-super-secret-key-min-32-chars
JWT_EXPIRES_IN=1h

# Master secret for quick-token endpoint (openssl rand -hex 24)
MASTER_SECRET=your-master-secret

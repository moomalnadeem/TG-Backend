
# Dev Keys
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Supabase project ref (the ID in your Supabase URL)
SUPABASE_PROJECT_REF=your-project-ref

# Personal access token — https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your-access-token

# JWT — generate a strong random secret (e.g. openssl rand -hex 64)
JWT_SECRET=your-super-secret-key-min-32-chars
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=your-refresh-token-secret-different-from-jwt-secret
REFRESH_TOKEN_EXPIRES_IN=7d

# Master secret for quick-token endpoint (openssl rand -hex 24)
MASTER_SECRET=your-master-secret

# OTP login (website users)
OTP_EXPIRY_MINUTES=5

# ZeptoMail — paste the value exactly as shown in ZeptoMail > Mail Agent > API,
# including the "Zoho-enczapikey " prefix
ZEPTOMAIL_TOKEN=Zoho-enczapikey your-zeptomail-api-token
ZEPTOMAIL_FROM_EMAIL=noreply@yourdomain.com
ZEPTOMAIL_FROM_NAME=TG
# Zoho is region-specific — match the domain your dashboard lives on:
# global/US zeptomail.com -> api.zeptomail.com | EU zeptomail.eu -> api.zeptomail.eu
# India zeptomail.in -> api.zeptomail.in | UAE zeptomail.zoho.ae -> api.zeptomail.ae
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
# Optional — a Mail Agent template's key (Templates tab); when set, the OTP is sent
# as a merge field instead of the plain inline HTML built into the code
ZEPTOMAIL_TEMPLATE_KEY=
# Must match the merge tag name used inside that template's body/subject (e.g. {{otp}})
ZEPTOMAIL_OTP_MERGE_FIELD=otp
# Some templates also expect a "product_name" merge field — your brand/company name
ZEPTOMAIL_PRODUCT_NAME=TG

# WhatsApp — Meta Cloud API (Business Manager > WhatsApp > API Setup)
WHATSAPP_ACCESS_TOKEN=your-whatsapp-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_API_VERSION=v20.0
# Must match an approved authentication template in WhatsApp Manager
WHATSAPP_OTP_TEMPLATE_NAME=otp_login
WHATSAPP_OTP_TEMPLATE_LANG=en_US
# Set to "true" only if that template has a "Copy Code" auth button component
WHATSAPP_OTP_BUTTON_ENABLED=false



